#!/bin/sh
# Yaxiang OS writable system API. All persistent settings use UCI commits.

json_ok() {
	printf '{"success":true,"data":%s}\n' "$1"
}

json_error() {
	printf '{"success":false,"message":"%s"}\n' "$1"
}

read_field() {
	input="$(cat)"
	printf '%s' "$input" | jsonfilter -e "@.$1" 2>/dev/null
}

case "$1" in
	list)
		cat <<'EOF'
{
  "sys.info": {},
  "sys.hostname_get": {},
  "sys.hostname_set": {"hostname":"Yaxiang-Gateway"},
  "sys.timezone_get": {},
  "sys.timezone_set": {"timezone":"CST-8"}
}
EOF
		;;
	call)
		case "$2" in
		sys.info)
			hostname="$(uci -q get system.@system[0].hostname || printf unknown)"
			uptime="$(awk '{print int($1)}' /proc/uptime 2>/dev/null || printf 0)"
			json_ok "{\"hostname\":\"$hostname\",\"uptime\":$uptime}"
			;;
		sys.hostname_get)
			hostname="$(uci -q get system.@system[0].hostname || cat /etc/hostname)"
			json_ok "{\"hostname\":\"$hostname\"}"
			;;
		sys.hostname_set)
			hostname="$(read_field hostname)"
			case "$hostname" in
				""|*[!A-Za-z0-9.-]*|.*|*..*|*.)
					json_error "主机名格式无效"
					exit 0
					;;
			esac
			[ "${#hostname}" -le 63 ] ||
				{ json_error "主机名不能超过 63 个字符"; exit 0; }

			uci set system.@system[0].hostname="$hostname" ||
				{ json_error "UCI 写入失败"; exit 0; }
			uci commit system ||
				{ json_error "UCI 提交失败"; exit 0; }
			printf '%s\n' "$hostname" > /etc/hostname ||
				{ json_error "hostname 文件写入失败"; exit 0; }
			/etc/init.d/system reload ||
				{ json_error "system 服务重载失败"; exit 0; }
			json_ok "{\"hostname\":\"$hostname\"}"
			;;
		sys.timezone_get)
			timezone="$(uci -q get system.@system[0].timezone || printf UTC0)"
			json_ok "{\"timezone\":\"$timezone\"}"
			;;
		sys.timezone_set)
			timezone="$(read_field timezone)"
			case "$timezone" in
				CST-8|JST-9|UTC0) ;;
				*) json_error "不支持的时区"; exit 0 ;;
			esac
			uci set system.@system[0].timezone="$timezone" &&
				uci commit system &&
				/etc/init.d/system reload ||
				{ json_error "时区提交或重载失败"; exit 0; }
			json_ok "{\"timezone\":\"$timezone\"}"
			;;
		*)
			json_error "未知方法"
			;;
		esac
		;;
esac
