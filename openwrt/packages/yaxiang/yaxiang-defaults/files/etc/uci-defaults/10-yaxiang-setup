#!/bin/sh
# Yaxiang OS first-boot defaults.
# This script must complete successfully so OpenWrt removes it after first boot.

set -eu

DEFAULTS_MARKER=/etc/yaxiang-defaults-applied

[ -f "$DEFAULTS_MARKER" ] && exit 0

echo "[yaxiang-defaults] applying first-boot configuration"

# Set the factory hostname once. Subsequent changes are owned by UCI and must
# never be overwritten by this defaults script.
uci set system.@system[0].hostname='Yaxiang-Gateway'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system
printf '%s\n' 'Yaxiang-Gateway' > /etc/hostname

uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci -q delete network.lan.ip6assign || true

# The generic x86 image creates only LAN.  Define an explicit second-NIC WAN
# so DHCP, routing and the firewall's wan zone are exercised and enforced.
uci -q delete network.wan || true
uci set network.wan='interface'
uci set network.wan.device='eth1'
uci set network.wan.proto='dhcp'
uci -q delete network.wan6 || true
uci set network.wan6='interface'
uci set network.wan6.device='eth1'
uci set network.wan6.proto='dhcpv6'
uci commit network

uci set dhcp.lan.ignore='0'
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'
uci commit dhcp

# A stable named rule prevents duplicate rules if a boot is interrupted.
uci -q delete firewall.yaxiang_wan_management || true
uci set firewall.yaxiang_wan_management='rule'
uci set firewall.yaxiang_wan_management.name='Reject-WAN-Management'
uci set firewall.yaxiang_wan_management.src='wan'
uci set firewall.yaxiang_wan_management.dest_port='22 80 443'
uci set firewall.yaxiang_wan_management.proto='tcp'
uci set firewall.yaxiang_wan_management.target='REJECT'
uci commit firewall

mkdir -p /etc/yaxiang /var/run/yaxiang /var/log/yaxiang

# An image ships with an empty root password. Until initialization succeeds,
# expose only the HTTPS setup page and keep remote management daemons disabled.
/etc/init.d/dropbear disable
/etc/init.d/dropbear stop 2>/dev/null || true
/etc/init.d/rpcd disable
/etc/init.d/rpcd stop 2>/dev/null || true

/etc/init.d/yaxiang-security-gate enable
/usr/sbin/yaxiang-security-gate-apply
/etc/init.d/uhttpd enable

touch "$DEFAULTS_MARKER"
echo "[yaxiang-defaults] first-boot configuration complete"
exit 0
