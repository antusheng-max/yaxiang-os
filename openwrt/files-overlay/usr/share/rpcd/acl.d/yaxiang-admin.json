{
  "yaxiang-admin": {
    "description": "Yaxiang OS admin access",
    "read": {
      "ubus": {
        "yaxiang_network": ["*"],
        "yaxiang_lanwan": ["*"],
        "yaxiang_firewall": ["*"],
        "yaxiang_system2": ["*"],
        "yaxiang_monitor": ["*"],
        "yaxiang_vlan_pppoe": ["*"],
        "yaxiang_advanced": ["*"],
        "network.interface": ["dump", "status"],
        "network.device": ["status"],
        "system": ["info", "board"],
        "luci-rpc": ["*"]
      }
    },
    "write": {
      "ubus": {
        "yaxiang_network": ["*"],
        "yaxiang_lanwan": ["*"],
        "yaxiang_firewall": ["*"],
        "yaxiang_system2": ["*"],
        "yaxiang_vlan_pppoe": ["*"],
        "yaxiang_advanced": ["*"],
        "network.interface": ["up", "down", "restart"]
      }
    }
  }
}
