#!/bin/sh
# Yaxiang OS - Multi-WAN / Health Check / Traffic Control / Scheduling API
# 多WAN策略路由 + 线路健康检查 + tc流控 + 智能调度 + 带宽探测

NETCTL="/usr/lib/yaxiang/netctl.sh"
[ -f "$NETCTL" ] && . "$NETCTL"

json_ok() { printf '{"success":true,"implemented":true,"source":"%s","data":%s,"message":"","changed":%s}\n' "${3:-uci}" "$1" "${2:-false}"; }
json_err() { printf '{"success":false,"implemented":true,"source":"uci","data":null,"message":"%s"}\n' "$1"; }

MWAN_STATE="/var/run/yaxiang/mwan"
HC_STATE="/var/run/yaxiang/healthcheck"
SCHED_STATE="/var/run/yaxiang/scheduler"
BW_STATE="/var/run/yaxiang/bandwidth"
mkdir -p "$MWAN_STATE" "$HC_STATE" "$SCHED_STATE" "$BW_STATE" 2>/dev/null

case "$1" in
  list)
    cat <<EOF
{
  "mwan.status": {},
  "mwan.policies": {},
  "mwan.set_mode": {"mode":"balance"},
  "mwan.set_weight": {"interface":"wan","weight":"5"},
  "mwan.set_enabled": {"interface":"wan","enabled":"1"},
  "mwan.force_route": {"interface":"wan","dest":"8.8.8.8"},
  "mwan.rules": {},
  "mwan.add_rule": {"name":"r1","src":"192.168.1.0/24","dest_port":"443","use":"wan"},
  "mwan.del_rule": {"name":"r1"},
  "mwan.hits": {},
  "hc.status": {},
  "hc.status_one": {"interface":"wan"},
  "hc.configure": {"interface":"wan","target":"8.8.8.8","method":"icmp","interval":"10","threshold":"3"},
  "hc.inject_fault": {"interface":"wan","type":"down"},
  "hc.clear_fault": {"interface":"wan"},
  "tc.status": {},
  "tc.set_limit": {"interface":"wan","direction":"down","rate":"100mbit","burst":"15k"},
  "tc.set_device_limit": {"ip":"192.168.1.100","rate":"10mbit"},
  "tc.clear": {"interface":"wan"},
  "tc.stats": {"interface":"wan"},
  "sched.overview": {},
  "sched.ranking": {},
  "sched.set_priority": {"interface":"wan","priority":"10"},
  "sched.set_cost": {"interface":"wan","cost":"100"},
  "sched.hits": {},
  "sched.params": {},
  "sched.set_params": {"min_interval":"30","max_change":"20","cooldown":"60"},
  "bw.status": {},
  "bw.start_probe": {"interface":"wan","nominal_up":"100mbit"},
  "bw.stop_probe": {"interface":"wan"},
  "bw.set_limit": {"interface":"wan","max_up":"200mbit"},
  "bw.history": {"interface":"wan"},
  "carrier.lookup": {"ip":"8.8.8.8"},
  "carrier.stats": {},
  "carrier.import_status": {}
}
EOF
  ;;
  call)
    method="$2"
    case "$method" in

      # ==================== Multi-WAN ====================

      mwan.status)
        RESULT="["
        FIRST=1
        for sec in $(uci show network 2>/dev/null | grep "=interface" | cut -d. -f2 | cut -d= -f1 | grep "^wan"); do
          STATUS=$(ubus call network.interface.$sec status 2>/dev/null)
          UP=$(echo "$STATUS" | jsonfilter -e '@.up' 2>/dev/null || echo "false")
          IP4=$(echo "$STATUS" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || echo "")
          WEIGHT=$(uci get mwan3.$sec.weight 2>/dev/null || uci get network.$sec.yaxiang_weight 2>/dev/null || echo "1")
          ENABLED=$(uci get network.$sec.yaxiang_mwan_enabled 2>/dev/null || echo "1")
          TABLE_ID=$(uci get network.$sec.yaxiang_table 2>/dev/null || echo "0")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"name\":\"${sec}\",\"up\":${UP},\"ipv4\":\"${IP4}\",\"weight\":${WEIGHT},\"enabled\":$([ \"$ENABLED\" = \"1\" ] && echo true || echo false),\"table_id\":${TABLE_ID}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        MODE=$(uci get yaxiang.mwan.mode 2>/dev/null || echo "balance")
        json_ok "{\"interfaces\":${RESULT},\"mode\":\"${MODE}\"}" "false" "mwan"
        ;;

      mwan.policies)
        MODE=$(uci get yaxiang.mwan.mode 2>/dev/null || echo "balance")
        json_ok "{\"mode\":\"${MODE}\",\"policies\":[\"balance\",\"primary_backup\",\"weighted\",\"lowest_latency\",\"lowest_loss\"]}" "false" "mwan"
        ;;

      mwan.set_mode)
        read -r input
        MODE=$(echo "$input" | jsonfilter -e '@.mode' 2>/dev/null | tr -cd 'a-z_')
        case "$MODE" in balance|primary_backup|weighted|lowest_latency|lowest_loss) ;; *) json_err "invalid mode"; exit 0 ;; esac
        uci set yaxiang.mwan.mode="$MODE" 2>/dev/null || { uci set yaxiang.mwan=yaxiang; uci set yaxiang.mwan.mode="$MODE"; }
        uci commit yaxiang 2>/dev/null
        json_ok "{\"mode\":\"${MODE}\"}" true "mwan"
        ;;

      mwan.set_weight)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        WEIGHT=$(echo "$input" | jsonfilter -e '@.weight' 2>/dev/null | tr -cd '0-9')
        [ -z "$IFACE" ] || [ -z "$WEIGHT" ] && { json_err "interface and weight required"; exit 0; }
        [ "$WEIGHT" -lt 1 ] || [ "$WEIGHT" -gt 100 ] && { json_err "weight must be 1-100"; exit 0; }
        uci set network.$IFACE.yaxiang_weight="$WEIGHT" 2>/dev/null
        uci commit network 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"weight\":${WEIGHT}}" true "mwan"
        ;;

      mwan.set_enabled)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        ENABLED=$(echo "$input" | jsonfilter -e '@.enabled' 2>/dev/null | tr -cd '01')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        uci set network.$IFACE.yaxiang_mwan_enabled="$ENABLED" 2>/dev/null
        uci commit network 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"enabled\":$([ \"$ENABLED\" = \"1\" ] && echo true || echo false)}" true "mwan"
        ;;

      mwan.force_route)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        DEST=$(echo "$input" | jsonfilter -e '@.dest' 2>/dev/null | tr -cd '0-9./')
        [ -z "$IFACE" ] || [ -z "$DEST" ] && { json_err "interface and dest required"; exit 0; }
        # 获取接口网关
        GW=$(ubus call network.interface.$IFACE status 2>/dev/null | jsonfilter -e '@.route[0].nexthop' 2>/dev/null || echo "")
        if [ -n "$GW" ]; then
          ip route add "$DEST" via "$GW" dev "$(uci get network.$IFACE.device 2>/dev/null || echo eth0)" 2>/dev/null
          json_ok "{\"dest\":\"${DEST}\",\"via\":\"${GW}\",\"interface\":\"${IFACE}\"}" true "mwan"
        else
          json_err "no gateway for $IFACE"
        fi
        ;;

      mwan.rules)
        RESULT="["
        FIRST=1
        for sec in $(uci show yaxiang 2>/dev/null | grep "=mwan_rule" | cut -d. -f2 | cut -d= -f1); do
          SRC=$(uci get yaxiang.$sec.src 2>/dev/null || echo "")
          DPORT=$(uci get yaxiang.$sec.dest_port 2>/dev/null || echo "")
          USE=$(uci get yaxiang.$sec.use 2>/dev/null || echo "")
          HITS=$(cat "$MWAN_STATE/$sec.hits" 2>/dev/null || echo "0")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"name\":\"${sec}\",\"src\":\"${SRC}\",\"dest_port\":\"${DPORT}\",\"use\":\"${USE}\",\"hits\":${HITS}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"rules\":${RESULT}}" "false" "mwan"
        ;;

      mwan.add_rule)
        read -r input
        NAME=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        SRC=$(echo "$input" | jsonfilter -e '@.src' 2>/dev/null | tr -cd '0-9./')
        DPORT=$(echo "$input" | jsonfilter -e '@.dest_port' 2>/dev/null | tr -cd '0-9-')
        USE=$(echo "$input" | jsonfilter -e '@.use' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$NAME" ] && { json_err "name required"; exit 0; }
        uci set yaxiang.$NAME=mwan_rule
        [ -n "$SRC" ] && uci set yaxiang.$NAME.src="$SRC"
        [ -n "$DPORT" ] && uci set yaxiang.$NAME.dest_port="$DPORT"
        [ -n "$USE" ] && uci set yaxiang.$NAME.use="$USE"
        uci commit yaxiang 2>/dev/null
        json_ok "{\"name\":\"${NAME}\",\"action\":\"created\"}" true "mwan"
        ;;

      mwan.del_rule)
        read -r input
        NAME=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$NAME" ] && { json_err "name required"; exit 0; }
        uci delete yaxiang.$NAME 2>/dev/null
        uci commit yaxiang 2>/dev/null
        rm -f "$MWAN_STATE/$NAME.hits" 2>/dev/null
        json_ok "{\"name\":\"${NAME}\",\"action\":\"deleted\"}" true "mwan"
        ;;

      mwan.hits)
        RESULT="["
        FIRST=1
        for f in "$MWAN_STATE"/*.hits; do
          [ -f "$f" ] || continue
          NAME=$(basename "$f" .hits)
          HITS=$(cat "$f" 2>/dev/null || echo "0")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"rule\":\"${NAME}\",\"hits\":${HITS}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"hits\":${RESULT}}" "false" "mwan"
        ;;

      # ==================== Health Check ====================

      hc.status)
        RESULT="["
        FIRST=1
        for sec in $(uci show network 2>/dev/null | grep "=interface" | cut -d. -f2 | cut -d= -f1 | grep "^wan"); do
          STATE=$(cat "$HC_STATE/$sec.state" 2>/dev/null || echo "init")
          LATENCY=$(cat "$HC_STATE/$sec.latency" 2>/dev/null || echo "-1")
          LOSS=$(cat "$HC_STATE/$sec.loss" 2>/dev/null || echo "-1")
          FAILS=$(cat "$HC_STATE/$sec.fails" 2>/dev/null || echo "0")
          LAST_OK=$(cat "$HC_STATE/$sec.last_ok" 2>/dev/null || echo "0")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${sec}\",\"state\":\"${STATE}\",\"latency_ms\":${LATENCY},\"loss_percent\":${LOSS},\"consecutive_fails\":${FAILS},\"last_ok\":${LAST_OK}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"interfaces\":${RESULT}}" "false" "healthcheck"
        ;;

      hc.status_one)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        STATE=$(cat "$HC_STATE/$IFACE.state" 2>/dev/null || echo "init")
        LATENCY=$(cat "$HC_STATE/$IFACE.latency" 2>/dev/null || echo "-1")
        JITTER=$(cat "$HC_STATE/$IFACE.jitter" 2>/dev/null || echo "-1")
        LOSS=$(cat "$HC_STATE/$IFACE.loss" 2>/dev/null || echo "-1")
        FAILS=$(cat "$HC_STATE/$IFACE.fails" 2>/dev/null || echo "0")
        RECOVERS=$(cat "$HC_STATE/$IFACE.recovers" 2>/dev/null || echo "0")
        LAST_OK=$(cat "$HC_STATE/$IFACE.last_ok" 2>/dev/null || echo "0")
        TARGET=$(uci get yaxiang.hc_${IFACE}_target 2>/dev/null || echo "8.8.8.8")
        METHOD=$(uci get yaxiang.hc_${IFACE}_method 2>/dev/null || echo "icmp")
        INTERVAL=$(uci get yaxiang.hc_${IFACE}_interval 2>/dev/null || echo "10")
        json_ok "{\"interface\":\"${IFACE}\",\"state\":\"${STATE}\",\"latency_ms\":${LATENCY},\"jitter_ms\":${JITTER},\"loss_percent\":${LOSS},\"consecutive_fails\":${FAILS},\"consecutive_recovers\":${RECOVERS},\"last_ok\":${LAST_OK},\"target\":\"${TARGET}\",\"method\":\"${METHOD}\",\"interval\":${INTERVAL}}" "false" "healthcheck"
        ;;

      hc.configure)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        TARGET=$(echo "$input" | jsonfilter -e '@.target' 2>/dev/null | tr -cd '0-9a-fA-F.:')
        METHOD=$(echo "$input" | jsonfilter -e '@.method' 2>/dev/null | tr -cd 'a-z')
        INTERVAL=$(echo "$input" | jsonfilter -e '@.interval' 2>/dev/null | tr -cd '0-9')
        THRESHOLD=$(echo "$input" | jsonfilter -e '@.threshold' 2>/dev/null | tr -cd '0-9')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        case "$METHOD" in icmp|tcp|dns|http) ;; *) METHOD="icmp" ;; esac
        uci set yaxiang.hc_${IFACE}_target="${TARGET:-8.8.8.8}" 2>/dev/null || { uci set yaxiang.hc_${IFACE}_target=yaxiang_hc; }
        uci set yaxiang.hc_${IFACE}_target="$TARGET" 2>/dev/null
        uci set yaxiang.hc_${IFACE}_method="$METHOD" 2>/dev/null
        uci set yaxiang.hc_${IFACE}_interval="${INTERVAL:-10}" 2>/dev/null
        uci set yaxiang.hc_${IFACE}_threshold="${THRESHOLD:-3}" 2>/dev/null
        uci commit yaxiang 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"configured\":true}" true "healthcheck"
        ;;

      hc.inject_fault)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        TYPE=$(echo "$input" | jsonfilter -e '@.type' 2>/dev/null | tr -cd 'a-z_')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        echo "$TYPE" > "$HC_STATE/$IFACE.fault" 2>/dev/null
        echo "offline" > "$HC_STATE/$IFACE.state" 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"fault\":\"${TYPE}\",\"state\":\"offline\"}" true "healthcheck"
        ;;

      hc.clear_fault)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        rm -f "$HC_STATE/$IFACE.fault" 2>/dev/null
        echo "online" > "$HC_STATE/$IFACE.state" 2>/dev/null
        echo "0" > "$HC_STATE/$IFACE.fails" 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"state\":\"online\"}" true "healthcheck"
        ;;

      # ==================== Traffic Control ====================

      tc.status)
        RESULT="["
        FIRST=1
        for sec in $(uci show network 2>/dev/null | grep "=interface" | cut -d. -f2 | cut -d= -f1 | grep "^wan"); do
          DEV=$(uci get network.$sec.device 2>/dev/null || echo "")
          DL_RATE=$(uci get yaxiang.tc_${sec}_dl 2>/dev/null || echo "")
          UL_RATE=$(uci get yaxiang.tc_${sec}_ul 2>/dev/null || echo "")
          ACTIVE="false"
          [ -n "$DEV" ] && tc qdisc show dev "$DEV" 2>/dev/null | grep -q "tbf\|htb\|cake" && ACTIVE="true"
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${sec}\",\"device\":\"${DEV}\",\"dl_rate\":\"${DL_RATE}\",\"ul_rate\":\"${UL_RATE}\",\"active\":${ACTIVE}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"interfaces\":${RESULT}}" "false" "tc"
        ;;

      tc.set_limit)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        DIR=$(echo "$input" | jsonfilter -e '@.direction' 2>/dev/null | tr -cd 'a-z')
        RATE=$(echo "$input" | jsonfilter -e '@.rate' 2>/dev/null | tr -cd '0-9a-z')
        BURST=$(echo "$input" | jsonfilter -e '@.burst' 2>/dev/null | tr -cd '0-9a-z')
        [ -z "$IFACE" ] || [ -z "$RATE" ] && { json_err "interface and rate required"; exit 0; }
        DEV=$(uci get network.$IFACE.device 2>/dev/null || echo "")
        [ -z "$DEV" ] && { json_err "no device for $IFACE"; exit 0; }
        case "$DIR" in down|up) ;; *) DIR="down" ;; esac
        # 备份当前tc配置
        tc qdisc show dev "$DEV" > "/tmp/yaxiang-tc-backup-$IFACE" 2>/dev/null
        # 应用限速
        if [ "$DIR" = "down" ]; then
          tc qdisc del dev "$DEV" root 2>/dev/null
          tc qdisc add dev "$DEV" root tbf rate "$RATE" burst "${BURST:-15k}" latency 50ms 2>/dev/null
          uci set yaxiang.tc_${IFACE}_dl="$RATE" 2>/dev/null
        else
          tc qdisc del dev "ifb0" root 2>/dev/null
          uci set yaxiang.tc_${IFACE}_ul="$RATE" 2>/dev/null
        fi
        uci commit yaxiang 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"direction\":\"${DIR}\",\"rate\":\"${RATE}\"}" true "tc"
        ;;

      tc.set_device_limit)
        read -r input
        IP=$(echo "$input" | jsonfilter -e '@.ip' 2>/dev/null | tr -cd '0-9.')
        RATE=$(echo "$input" | jsonfilter -e '@.rate' 2>/dev/null | tr -cd '0-9a-z')
        [ -z "$IP" ] || [ -z "$RATE" ] && { json_err "ip and rate required"; exit 0; }
        uci set yaxiang.tc_dev_${IP//./_}="$RATE" 2>/dev/null || { uci set yaxiang.tc_dev=yaxiang_tc_dev; }
        uci commit yaxiang 2>/dev/null
        json_ok "{\"ip\":\"${IP}\",\"rate\":\"${RATE}\"}" true "tc"
        ;;

      tc.clear)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        DEV=$(uci get network.$IFACE.device 2>/dev/null || echo "")
        [ -n "$DEV" ] && tc qdisc del dev "$DEV" root 2>/dev/null
        uci delete yaxiang.tc_${IFACE}_dl 2>/dev/null
        uci delete yaxiang.tc_${IFACE}_ul 2>/dev/null
        uci commit yaxiang 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"action\":\"cleared\"}" true "tc"
        ;;

      tc.stats)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        DEV=$(uci get network.$IFACE.device 2>/dev/null || echo "")
        STATS=""
        if [ -n "$DEV" ]; then
          STATS=$(tc -s qdisc show dev "$DEV" 2>/dev/null | head -20 | tr '\n' '|')
        fi
        json_ok "{\"interface\":\"${IFACE}\",\"device\":\"${DEV}\",\"stats\":\"${STATS}\"}" "false" "tc"
        ;;

      # ==================== Smart Scheduling ====================

      sched.overview)
        RESULT="["
        FIRST=1
        for sec in $(uci show network 2>/dev/null | grep "=interface" | cut -d. -f2 | cut -d= -f1 | grep "^wan"); do
          STATE=$(cat "$HC_STATE/$sec.state" 2>/dev/null || echo "init")
          WEIGHT=$(uci get network.$sec.yaxiang_weight 2>/dev/null || echo "1")
          PRIORITY=$(uci get network.$sec.yaxiang_priority 2>/dev/null || echo "5")
          SCORE4=$(cat "$SCHED_STATE/$sec.score4" 2>/dev/null || echo "0")
          SCORE6=$(cat "$SCHED_STATE/$sec.score6" 2>/dev/null || echo "0")
          LATENCY=$(cat "$HC_STATE/$sec.latency" 2>/dev/null || echo "-1")
          LOSS=$(cat "$HC_STATE/$sec.loss" 2>/dev/null || echo "-1")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${sec}\",\"state\":\"${STATE}\",\"weight\":${WEIGHT},\"priority\":${PRIORITY},\"score_ipv4\":${SCORE4},\"score_ipv6\":${SCORE6},\"latency\":${LATENCY},\"loss\":${LOSS}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        MODE=$(uci get yaxiang.mwan.mode 2>/dev/null || echo "balance")
        json_ok "{\"interfaces\":${RESULT},\"mode\":\"${MODE}\"}" "false" "scheduler"
        ;;

      sched.ranking)
        RESULT="["
        FIRST=1
        for sec in $(uci show network 2>/dev/null | grep "=interface" | cut -d. -f2 | cut -d= -f1 | grep "^wan"); do
          SCORE4=$(cat "$SCHED_STATE/$sec.score4" 2>/dev/null || echo "0")
          SCORE6=$(cat "$SCHED_STATE/$sec.score6" 2>/dev/null || echo "0")
          STATE=$(cat "$HC_STATE/$sec.state" 2>/dev/null || echo "init")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${sec}\",\"score_ipv4\":${SCORE4},\"score_ipv6\":${SCORE6},\"state\":\"${STATE}\"}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"ranking\":${RESULT}}" "false" "scheduler"
        ;;

      sched.set_priority)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        PRI=$(echo "$input" | jsonfilter -e '@.priority' 2>/dev/null | tr -cd '0-9')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        uci set network.$IFACE.yaxiang_priority="${PRI:-5}" 2>/dev/null
        uci commit network 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"priority\":${PRI:-5}}" true "scheduler"
        ;;

      sched.set_cost)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        COST=$(echo "$input" | jsonfilter -e '@.cost' 2>/dev/null | tr -cd '0-9')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        uci set network.$IFACE.yaxiang_cost="${COST:-100}" 2>/dev/null
        uci commit network 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"cost\":${COST:-100}}" true "scheduler"
        ;;

      sched.hits)
        RESULT="["
        FIRST=1
        for f in "$SCHED_STATE"/*.hits; do
          [ -f "$f" ] || continue
          NAME=$(basename "$f" .hits)
          HITS=$(cat "$f" 2>/dev/null || echo "0")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${NAME}\",\"hits\":${HITS}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"hits\":${RESULT}}" "false" "scheduler"
        ;;

      sched.params)
        MIN_INT=$(uci get yaxiang.sched.min_interval 2>/dev/null || echo "30")
        MAX_CHG=$(uci get yaxiang.sched.max_change 2>/dev/null || echo "20")
        COOLDOWN=$(uci get yaxiang.sched.cooldown 2>/dev/null || echo "60")
        ANTI_OSC=$(uci get yaxiang.sched.anti_oscillation 2>/dev/null || echo "1")
        json_ok "{\"min_interval\":${MIN_INT},\"max_change\":${MAX_CHG},\"cooldown\":${COOLDOWN},\"anti_oscillation\":$([ \"$ANTI_OSC\" = \"1\" ] && echo true || echo false)}" "false" "scheduler"
        ;;

      sched.set_params)
        read -r input
        MIN_INT=$(echo "$input" | jsonfilter -e '@.min_interval' 2>/dev/null | tr -cd '0-9')
        MAX_CHG=$(echo "$input" | jsonfilter -e '@.max_change' 2>/dev/null | tr -cd '0-9')
        COOLDOWN=$(echo "$input" | jsonfilter -e '@.cooldown' 2>/dev/null | tr -cd '0-9')
        [ -n "$MIN_INT" ] && uci set yaxiang.sched.min_interval="$MIN_INT" 2>/dev/null
        [ -n "$MAX_CHG" ] && uci set yaxiang.sched.max_change="$MAX_CHG" 2>/dev/null
        [ -n "$COOLDOWN" ] && uci set yaxiang.sched.cooldown="$COOLDOWN" 2>/dev/null
        uci commit yaxiang 2>/dev/null
        json_ok "{\"updated\":true}" true "scheduler"
        ;;

      # ==================== Bandwidth Probing ====================

      bw.status)
        RESULT="["
        FIRST=1
        for sec in $(uci show network 2>/dev/null | grep "=interface" | cut -d. -f2 | cut -d= -f1 | grep "^wan"); do
          PROBING=$(cat "$BW_STATE/$sec.probing" 2>/dev/null || echo "false")
          NOMINAL=$(uci get yaxiang.bw_${sec}_nominal 2>/dev/null || echo "0")
          EFFECTIVE=$(cat "$BW_STATE/$sec.effective" 2>/dev/null || echo "0")
          MAX_FOUND=$(cat "$BW_STATE/$sec.max_found" 2>/dev/null || echo "0")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${sec}\",\"probing\":${PROBING},\"nominal_mbps\":${NOMINAL},\"effective_mbps\":${EFFECTIVE},\"max_found_mbps\":${MAX_FOUND}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"interfaces\":${RESULT}}" "false" "bandwidth"
        ;;

      bw.start_probe)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        NOMINAL=$(echo "$input" | jsonfilter -e '@.nominal_up' 2>/dev/null | tr -cd '0-9')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        echo "true" > "$BW_STATE/$IFACE.probing" 2>/dev/null
        [ -n "$NOMINAL" ] && uci set yaxiang.bw_${IFACE}_nominal="$NOMINAL" 2>/dev/null && uci commit yaxiang 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"probing\":true}" true "bandwidth"
        ;;

      bw.stop_probe)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        echo "false" > "$BW_STATE/$IFACE.probing" 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"probing\":false}" true "bandwidth"
        ;;

      bw.set_limit)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        MAX_UP=$(echo "$input" | jsonfilter -e '@.max_up' 2>/dev/null | tr -cd '0-9')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        uci set yaxiang.bw_${IFACE}_max="${MAX_UP:-0}" 2>/dev/null
        uci commit yaxiang 2>/dev/null
        json_ok "{\"interface\":\"${IFACE}\",\"max_up\":\"${MAX_UP}\"}" true "bandwidth"
        ;;

      bw.history)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$IFACE" ] && { json_err "interface required"; exit 0; }
        HISTORY="[]"
        [ -f "$BW_STATE/$IFACE.history" ] && HISTORY=$(cat "$BW_STATE/$IFACE.history" 2>/dev/null || echo "[]")
        json_ok "{\"interface\":\"${IFACE}\",\"history\":${HISTORY}}" "false" "bandwidth"
        ;;

      # ==================== Carrier/Province ====================

      carrier.lookup)
        read -r input
        IP=$(echo "$input" | jsonfilter -e '@.ip' 2>/dev/null | tr -cd '0-9a-fA-F.:')
        [ -z "$IP" ] && { json_err "ip required"; exit 0; }
        # 检查数据库是否存在
        DB_FILE="/usr/share/yaxiang/ip_prefix_db.csv"
        if [ ! -f "$DB_FILE" ]; then
          json_ok "{\"ip\":\"${IP}\",\"carrier\":\"unknown\",\"province\":\"unknown\",\"db_loaded\":false,\"message\":\"未导入识别数据库\"}" "false" "carrier"
        else
          # 简单前缀匹配
          PREFIX=$(echo "$IP" | cut -d. -f1-2)
          MATCH=$(grep "^${PREFIX}" "$DB_FILE" 2>/dev/null | head -1)
          if [ -n "$MATCH" ]; then
            CARRIER=$(echo "$MATCH" | cut -d, -f2)
            PROVINCE=$(echo "$MATCH" | cut -d, -f3)
            json_ok "{\"ip\":\"${IP}\",\"carrier\":\"${CARRIER}\",\"province\":\"${PROVINCE}\",\"db_loaded\":true}" "false" "carrier"
          else
            json_ok "{\"ip\":\"${IP}\",\"carrier\":\"unknown\",\"province\":\"unknown\",\"db_loaded\":true}" "false" "carrier"
          fi
        fi
        ;;

      carrier.stats)
        DB_FILE="/usr/share/yaxiang/ip_prefix_db.csv"
        DB_LOADED="false"
        ENTRIES=0
        [ -f "$DB_FILE" ] && DB_LOADED="true" && ENTRIES=$(wc -l < "$DB_FILE" 2>/dev/null || echo "0")
        json_ok "{\"db_loaded\":${DB_LOADED},\"entries\":${ENTRIES}}" "false" "carrier"
        ;;

      carrier.import_status)
        DB_FILE="/usr/share/yaxiang/ip_prefix_db.csv"
        if [ -f "$DB_FILE" ]; then
          SIZE=$(du -h "$DB_FILE" | cut -f1)
          ENTRIES=$(wc -l < "$DB_FILE" 2>/dev/null || echo "0")
          MODIFIED=$(stat -c %Y "$DB_FILE" 2>/dev/null || echo "0")
          json_ok "{\"loaded\":true,\"size\":\"${SIZE}\",\"entries\":${ENTRIES},\"modified\":${MODIFIED}}" "false" "carrier"
        else
          json_ok "{\"loaded\":false,\"message\":\"未导入IP前缀数据库\"}" "false" "carrier"
        fi
        ;;

      *)
        printf '{"success":false,"implemented":false,"source":"unavailable","data":null,"message":"该功能尚未接入真实系统"}\n'
        ;;
    esac
  ;;
esac
