#!/bin/sh
# Yaxiang OS - Firewall/NAT API via rpcd/ubus
# 基于 firewall4/nftables 真实实现

NETCTL="/usr/lib/yaxiang/netctl.sh"
[ -f "$NETCTL" ] && . "$NETCTL"

json_ok() { printf '{"success":true,"implemented":true,"source":"nftables","data":%s,"message":"","changed":%s}\n' "$1" "${2:-false}"; }
json_err() { printf '{"success":false,"implemented":true,"source":"nftables","data":null,"message":"%s"}\n' "$1"; }

case "$1" in
  list)
    cat <<EOF
{
  "fw.zones": {},
  "fw.forwards": {},
  "fw.redirects": {},
  "fw.rules": {},
  "fw.add_redirect": {"name":"r1","src":"wan","dest":"lan","dest_ip":"192.168.1.100","dest_port":"80","src_port":"8080","proto":"tcp"},
  "fw.del_redirect": {"name":"r1"},
  "fw.add_rule": {"name":"rule1","src":"wan","dest":"lan","proto":"tcp","dest_port":"22","target":"ACCEPT"},
  "fw.del_rule": {"name":"rule1"},
  "fw.set_dmz": {"enabled":"1","host":"192.168.1.100","wan":"wan"},
  "fw.upnp_status": {},
  "fw.upnp_set": {"enabled":"1"},
  "fw.connections": {},
  "fw.reload": {}
}
EOF
  ;;
  call)
    method="$2"
    case "$method" in
      fw.zones)
        RESULT="["
        FIRST=1
        for sec in $(uci show firewall 2>/dev/null | grep "=zone" | cut -d. -f2 | cut -d= -f1); do
          NAME=$(uci get firewall.$sec.name 2>/dev/null || echo "$sec")
          INPUT=$(uci get firewall.$sec.input 2>/dev/null || echo "REJECT")
          OUTPUT=$(uci get firewall.$sec.output 2>/dev/null || echo "ACCEPT")
          FORWARD=$(uci get firewall.$sec.forward 2>/dev/null || echo "REJECT")
          MASQ=$(uci get firewall.$sec.masq 2>/dev/null || echo "0")
          NETWORK=$(uci get firewall.$sec.network 2>/dev/null || echo "")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"name\":\"${NAME}\",\"input\":\"${INPUT}\",\"output\":\"${OUTPUT}\",\"forward\":\"${FORWARD}\",\"masq\":$([ \"$MASQ\" = \"1\" ] && echo true || echo false),\"network\":\"${NETWORK}\"}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"zones\":${RESULT}}"
        ;;
      fw.forwards)
        RESULT="["
        FIRST=1
        for sec in $(uci show firewall 2>/dev/null | grep "=forwarding" | cut -d. -f2 | cut -d= -f1); do
          SRC=$(uci get firewall.$sec.src 2>/dev/null || echo "")
          DEST=$(uci get firewall.$sec.dest 2>/dev/null || echo "")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"name\":\"${sec}\",\"src\":\"${SRC}\",\"dest\":\"${DEST}\"}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"forwards\":${RESULT}}"
        ;;
      fw.redirects)
        RESULT="["
        FIRST=1
        for sec in $(uci show firewall 2>/dev/null | grep "=redirect" | cut -d. -f2 | cut -d= -f1); do
          NAME=$(uci get firewall.$sec.name 2>/dev/null || echo "$sec")
          SRC=$(uci get firewall.$sec.src 2>/dev/null || echo "")
          DEST=$(uci get firewall.$sec.dest 2>/dev/null || echo "")
          DEST_IP=$(uci get firewall.$sec.dest_ip 2>/dev/null || echo "")
          DEST_PORT=$(uci get firewall.$sec.dest_port 2>/dev/null || echo "")
          SRC_PORT=$(uci get firewall.$sec.src_dport 2>/dev/null || echo "")
          PROTO=$(uci get firewall.$sec.proto 2>/dev/null || echo "tcp")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"name\":\"${NAME}\",\"src\":\"${SRC}\",\"dest\":\"${DEST}\",\"dest_ip\":\"${DEST_IP}\",\"dest_port\":\"${DEST_PORT}\",\"src_port\":\"${SRC_PORT}\",\"proto\":\"${PROTO}\"}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"redirects\":${RESULT}}"
        ;;
      fw.add_redirect)
        read -r input
        NAME=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        SRC=$(echo "$input" | jsonfilter -e '@.src' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        DEST=$(echo "$input" | jsonfilter -e '@.dest' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        DEST_IP=$(echo "$input" | jsonfilter -e '@.dest_ip' 2>/dev/null | tr -cd '0-9.')
        DEST_PORT=$(echo "$input" | jsonfilter -e '@.dest_port' 2>/dev/null | tr -cd '0-9-')
        SRC_PORT=$(echo "$input" | jsonfilter -e '@.src_port' 2>/dev/null | tr -cd '0-9-')
        PROTO=$(echo "$input" | jsonfilter -e '@.proto' 2>/dev/null | tr -cd 'a-z')
        [ -z "$NAME" ] && { json_err "name required"; exit 0; }
        [ -f "$NETCTL" ] && { netctl_lock || { json_err "lock"; exit 0; }; netctl_backup firewall >/dev/null; }
        uci set firewall.$NAME=redirect
        uci set firewall.$NAME.name="$NAME"
        uci set firewall.$NAME.src="${SRC:-wan}"
        uci set firewall.$NAME.dest="${DEST:-lan}"
        [ -n "$DEST_IP" ] && uci set firewall.$NAME.dest_ip="$DEST_IP"
        [ -n "$DEST_PORT" ] && uci set firewall.$NAME.dest_port="$DEST_PORT"
        [ -n "$SRC_PORT" ] && uci set firewall.$NAME.src_dport="$SRC_PORT"
        uci set firewall.$NAME.proto="${PROTO:-tcp}"
        uci set firewall.$NAME.target=DNAT
        uci commit firewall
        /etc/init.d/firewall reload 2>/dev/null
        [ -f "$NETCTL" ] && { netctl_unlock; netctl_log "FW_REDIRECT_ADD" "$NAME"; }
        json_ok "{\"name\":\"${NAME}\",\"action\":\"created\"}" true
        ;;
      fw.del_redirect)
        read -r input
        NAME=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null | tr -cd 'a-zA-Z0-9_')
        [ -z "$NAME" ] && { json_err "name required"; exit 0; }
        [ -f "$NETCTL" ] && { netctl_lock || { json_err "lock"; exit 0; }; netctl_backup firewall >/dev/null; }
        uci delete firewall.$NAME 2>/dev/null
        uci commit firewall
        /etc/init.d/firewall reload 2>/dev/null
        [ -f "$NETCTL" ] && { netctl_unlock; netctl_log "FW_REDIRECT_DEL" "$NAME"; }
        json_ok "{\"name\":\"${NAME}\",\"action\":\"deleted\"}" true
        ;;
      fw.connections)
        COUNT=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
        MAX=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo "0")
        json_ok "{\"count\":${COUNT},\"max\":${MAX}}"
        ;;
      fw.upnp_status)
        RUNNING=$(/etc/init.d/miniupnpd status 2>/dev/null && echo "true" || echo "false")
        ENABLED=$(uci get upnpd.config.enabled 2>/dev/null || echo "0")
        json_ok "{\"running\":${RUNNING},\"enabled\":$([ \"$ENABLED\" = \"1\" ] && echo true || echo false)}"
        ;;
      fw.upnp_set)
        read -r input
        ENABLED=$(echo "$input" | jsonfilter -e '@.enabled' 2>/dev/null | tr -cd '01')
        uci set upnpd.config.enabled="${ENABLED:-0}" 2>/dev/null
        uci commit upnpd 2>/dev/null
        if [ "$ENABLED" = "1" ]; then /etc/init.d/miniupnpd start 2>/dev/null; else /etc/init.d/miniupnpd stop 2>/dev/null; fi
        json_ok "{\"enabled\":$([ \"$ENABLED\" = \"1\" ] && echo true || echo false)}" true
        ;;
      fw.reload)
        /etc/init.d/firewall reload 2>/dev/null
        json_ok "{\"action\":\"reloaded\"}" true
        ;;
      *)
        printf '{"success":false,"implemented":false,"source":"unavailable","data":null,"message":"该功能尚未接入真实系统"}\n'
        ;;
    esac
  ;;
esac
