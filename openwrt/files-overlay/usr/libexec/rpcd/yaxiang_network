#!/bin/sh
# Yaxiang OS - Network API via rpcd/ubus
# 真实网络信息端点 + 基础写入操作
# 第六阶段A: 网络控制底座接入

NETCTL="/usr/lib/yaxiang/netctl.sh"
[ -f "$NETCTL" ] && . "$NETCTL"

case "$1" in
  list)
    cat <<EOF
{
  "network.devices": {},
  "network.interfaces": {},
  "network.addresses": {},
  "network.routes": {},
  "network.dns": {},
  "network.link_status": {},
  "network.traffic_counters": {},
  "network.physical_devices": {},
  "network.device_info": {"interface":"iface"},
  "network.interface_config": {"interface":"iface"},
  "network.interface_ipv4": {"interface":"iface"},
  "network.interface_ipv6": {"interface":"iface"},
  "network.set_mtu": {"interface":"iface","mtu":"1500"},
  "network.set_description": {"interface":"iface","description":"note"},
  "network.set_link_state": {"interface":"iface","state":"up"},
  "lines.status": {}
}
EOF
  ;;

  call)
    method="$2"
    case "$method" in
      network.devices)
        # List network devices from ubus
        ubus call network.device status 2>/dev/null || echo '{"devices":[]}'
        ;;

      network.interfaces)
        # List network interfaces from ubus
        ubus call network.interface dump 2>/dev/null || echo '{"interface":[]}'
        ;;

      network.addresses)
        # IP addresses from ip command
        ip -json address 2>/dev/null || echo '[]'
        ;;

      network.routes)
        # Routing table from ip command
        ip -json route 2>/dev/null || echo '[]'
        ;;

      network.dns)
        # DNS configuration
        DNS_SERVERS=$(grep "^nameserver" /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null | awk '{print $2}' | head -5 | tr '\n' ',' | sed 's/,$//')
        echo "{\"dns_servers\":\"${DNS_SERVERS}\"}"
        ;;

      network.link_status)
        # Link status for each interface
        RESULT="["
        FIRST=1
        for iface in $(ls /sys/class/net/ 2>/dev/null | grep -v lo); do
          CARRIER=$(cat /sys/class/net/$iface/carrier 2>/dev/null || echo "0")
          SPEED=$(ethtool $iface 2>/dev/null | grep "Speed:" | awk '{print $2}' || echo "unknown")
          DUPLEX=$(ethtool $iface 2>/dev/null | grep "Duplex:" | awk '{print $2}' || echo "unknown")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${iface}\",\"carrier\":${CARRIER},\"speed\":\"${SPEED}\",\"duplex\":\"${DUPLEX}\"}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        echo "{\"links\":${RESULT}}"
        ;;

      network.traffic_counters)
        # Traffic counters from /proc/net/dev
        RESULT="["
        FIRST=1
        while IFS=: read -r iface stats; do
          iface=$(echo "$iface" | xargs)
          [ "$iface" = "lo" ] && continue
          [ -z "$iface" ] && continue
          RX_BYTES=$(echo "$stats" | awk '{print $1}')
          TX_BYTES=$(echo "$stats" | awk '{print $9}')
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${iface}\",\"rx_bytes\":${RX_BYTES},\"tx_bytes\":${TX_BYTES}}"
          FIRST=0
        done < /proc/net/dev 2>/dev/null
        RESULT="${RESULT}]"
        echo "{\"counters\":${RESULT}}"
        ;;

      lines.status)
        # WAN line status
        RESULT="["
        FIRST=1
        for iface in $(ubus call network.interface dump 2>/dev/null | jsonfilter -e '@.interface[@.device]'); do
          DEV=$(echo "$iface" | jsonfilter -e '@.device' 2>/dev/null)
          PROTO=$(echo "$iface" | jsonfilter -e '@.proto' 2>/dev/null)
          UP=$(echo "$iface" | jsonfilter -e '@.up' 2>/dev/null)
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"device\":\"${DEV}\",\"proto\":\"${PROTO}\",\"up\":${UP}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        echo "{\"lines\":${RESULT}}"
        ;;

      network.physical_devices)
        # 真实物理网卡列表
        RESULT="["
        FIRST=1
        for iface in $(ls /sys/class/net/ 2>/dev/null | grep -v lo); do
          MAC=$(cat /sys/class/net/$iface/address 2>/dev/null || echo "")
          MTU=$(cat /sys/class/net/$iface/mtu 2>/dev/null || echo "0")
          OPERSTATE=$(cat /sys/class/net/$iface/operstate 2>/dev/null || echo "unknown")
          CARRIER=$(cat /sys/class/net/$iface/carrier 2>/dev/null || echo "0")
          TYPE=$(cat /sys/class/net/$iface/type 2>/dev/null || echo "0")
          # 判断是否物理网卡
          IS_PHYSICAL="false"
          [ -d "/sys/class/net/$iface/device" ] && IS_PHYSICAL="true"
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"name\":\"${iface}\",\"mac\":\"${MAC}\",\"mtu\":${MTU},\"state\":\"${OPERSTATE}\",\"carrier\":${CARRIER},\"physical\":${IS_PHYSICAL}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        echo "{\"devices\":${RESULT}}"
        ;;

      network.device_info)
        # 单个网卡详细信息
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null)
        if [ -z "$IFACE" ] || [ ! -d "/sys/class/net/${IFACE}" ]; then
          echo '{"success":false,"error":"interface not found"}'
        else
          MAC=$(cat /sys/class/net/$IFACE/address 2>/dev/null || echo "")
          MTU=$(cat /sys/class/net/$IFACE/mtu 2>/dev/null || echo "0")
          OPERSTATE=$(cat /sys/class/net/$IFACE/operstate 2>/dev/null || echo "unknown")
          CARRIER=$(cat /sys/class/net/$IFACE/carrier 2>/dev/null || echo "0")
          SPEED=$(cat /sys/class/net/$IFACE/speed 2>/dev/null || echo "-1")
          DUPLEX=$(cat /sys/class/net/$IFACE/duplex 2>/dev/null || echo "unknown")
          # UCI备注
          DESC=$(uci get network.${IFACE}.description 2>/dev/null || echo "")
          echo "{\"name\":\"${IFACE}\",\"mac\":\"${MAC}\",\"mtu\":${MTU},\"state\":\"${OPERSTATE}\",\"carrier\":${CARRIER},\"speed_mbps\":${SPEED},\"duplex\":\"${DUPLEX}\",\"description\":\"${DESC}\"}"
        fi
        ;;

      network.interface_config)
        # UCI接口配置
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null)
        if [ -z "$IFACE" ]; then
          echo '{"success":false,"error":"interface required"}'
        else
          PROTO=$(uci get network.${IFACE}.proto 2>/dev/null || echo "none")
          DEVICE=$(uci get network.${IFACE}.device 2>/dev/null || echo "")
          IPADDR=$(uci get network.${IFACE}.ipaddr 2>/dev/null || echo "")
          NETMASK=$(uci get network.${IFACE}.netmask 2>/dev/null || echo "")
          GATEWAY=$(uci get network.${IFACE}.gateway 2>/dev/null || echo "")
          MTU=$(uci get network.${IFACE}.mtu 2>/dev/null || echo "")
          echo "{\"interface\":\"${IFACE}\",\"proto\":\"${PROTO}\",\"device\":\"${DEVICE}\",\"ipaddr\":\"${IPADDR}\",\"netmask\":\"${NETMASK}\",\"gateway\":\"${GATEWAY}\",\"mtu\":\"${MTU}\"}"
        fi
        ;;

      network.interface_ipv4)
        # 接口IPv4地址
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null)
        if [ -z "$IFACE" ]; then
          echo '{"success":false,"error":"interface required"}'
        else
          ADDR=$(ip -4 addr show dev "$IFACE" 2>/dev/null | grep inet | awk '{print $2}' | head -1)
          echo "{\"interface\":\"${IFACE}\",\"ipv4\":\"${ADDR:-}\"}"
        fi
        ;;

      network.interface_ipv6)
        # 接口IPv6地址
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null)
        if [ -z "$IFACE" ]; then
          echo '{"success":false,"error":"interface required"}'
        else
          ADDR=$(ip -6 addr show dev "$IFACE" scope global 2>/dev/null | grep inet6 | awk '{print $2}' | head -1)
          LLADDR=$(ip -6 addr show dev "$IFACE" scope link 2>/dev/null | grep inet6 | awk '{print $2}' | head -1)
          echo "{\"interface\":\"${IFACE}\",\"ipv6_global\":\"${ADDR:-}\",\"ipv6_link_local\":\"${LLADDR:-}\"}"
        fi
        ;;

      network.set_mtu)
        # 修改MTU (写入)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null)
        MTU=$(echo "$input" | jsonfilter -e '@.mtu' 2>/dev/null)
        if [ -f "$NETCTL" ]; then
          netctl_set_mtu "$IFACE" "$MTU"
        else
          echo '{"success":false,"error":"netctl not available"}'
        fi
        ;;

      network.set_description)
        # 修改网卡备注 (写入)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null)
        DESC=$(echo "$input" | jsonfilter -e '@.description' 2>/dev/null)
        if [ -f "$NETCTL" ]; then
          netctl_set "network" "$IFACE" "description" "$DESC"
        else
          echo '{"success":false,"error":"netctl not available"}'
        fi
        ;;

      network.set_link_state)
        # 启用/停用接口 (写入)
        read -r input
        IFACE=$(echo "$input" | jsonfilter -e '@.interface' 2>/dev/null)
        STATE=$(echo "$input" | jsonfilter -e '@.state' 2>/dev/null)
        if [ -f "$NETCTL" ]; then
          netctl_set_link_state "$IFACE" "$STATE"
        else
          echo '{"success":false,"error":"netctl not available"}'
        fi
        ;;

      *)
        echo "{\"implemented\":false,\"source\":\"unavailable\",\"reason\":\"未知方法: ${method}\"}"
        ;;
    esac
  ;;
esac
