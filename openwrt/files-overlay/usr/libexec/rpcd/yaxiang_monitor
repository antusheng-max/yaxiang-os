#!/bin/sh
# Yaxiang OS - Real-time Monitoring API via rpcd/ubus
# 真实系统指标读取，不使用随机数

json_ok() { printf '{"success":true,"implemented":true,"source":"procfs","data":%s,"message":"","changed":false}\n' "$1"; }

case "$1" in
  list)
    cat <<EOF
{
  "mon.cpu": {},
  "mon.memory": {},
  "mon.disk": {},
  "mon.load": {},
  "mon.temperature": {},
  "mon.interfaces": {},
  "mon.traffic": {},
  "mon.connections": {},
  "mon.uptime": {}
}
EOF
  ;;
  call)
    method="$2"
    case "$method" in
      mon.cpu)
        # 从/proc/stat读取CPU使用率
        read -r cpu user nice system idle iowait irq softirq steal rest < /proc/stat 2>/dev/null
        TOTAL=$((user + nice + system + idle + iowait + irq + softirq + steal))
        BUSY=$((user + nice + system + irq + softirq + steal))
        if [ "$TOTAL" -gt 0 ]; then
          USAGE=$((BUSY * 100 / TOTAL))
        else
          USAGE=0
        fi
        CORES=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo "1")
        MODEL=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^ *//')
        json_ok "{\"usage_percent\":${USAGE},\"cores\":${CORES},\"model\":\"${MODEL:-unknown}\"}"
        ;;
      mon.memory)
        MEM_TOTAL=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo "0")
        MEM_FREE=$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null || echo "0")
        MEM_USED=$((MEM_TOTAL - MEM_FREE))
        SWAP_TOTAL=$(awk '/SwapTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo "0")
        SWAP_FREE=$(awk '/SwapFree/ {print $2}' /proc/meminfo 2>/dev/null || echo "0")
        json_ok "{\"total_kb\":${MEM_TOTAL},\"used_kb\":${MEM_USED},\"free_kb\":${MEM_FREE},\"swap_total_kb\":${SWAP_TOTAL},\"swap_free_kb\":${SWAP_FREE}}"
        ;;
      mon.disk)
        DISK_TOTAL=$(df /overlay 2>/dev/null | tail -1 | awk '{print $2}')
        DISK_USED=$(df /overlay 2>/dev/null | tail -1 | awk '{print $3}')
        DISK_FREE=$(df /overlay 2>/dev/null | tail -1 | awk '{print $4}')
        json_ok "{\"total_kb\":${DISK_TOTAL:-0},\"used_kb\":${DISK_USED:-0},\"free_kb\":${DISK_FREE:-0}}"
        ;;
      mon.load)
        LOAD=$(cat /proc/loadavg 2>/dev/null | awk '{print $1","$2","$3}')
        PROCS=$(cat /proc/loadavg 2>/dev/null | awk '{print $4}')
        json_ok "{\"load\":\"${LOAD}\",\"processes\":\"${PROCS}\"}"
        ;;
      mon.temperature)
        TEMP=""
        for tz in /sys/class/thermal/thermal_zone*/temp; do
          [ -f "$tz" ] && TEMP=$(cat "$tz" 2>/dev/null) && break
        done
        if [ -n "$TEMP" ] && [ "$TEMP" -gt 0 ] 2>/dev/null; then
          TEMP_C=$((TEMP / 1000))
        else
          TEMP_C=-1
        fi
        json_ok "{\"temperature_c\":${TEMP_C}}"
        ;;
      mon.interfaces)
        RESULT="["
        FIRST=1
        for iface in $(ls /sys/class/net/ 2>/dev/null | grep -v lo); do
          STATE=$(cat /sys/class/net/$iface/operstate 2>/dev/null || echo "unknown")
          CARRIER=$(cat /sys/class/net/$iface/carrier 2>/dev/null || echo "0")
          SPEED=$(cat /sys/class/net/$iface/speed 2>/dev/null || echo "-1")
          MTU=$(cat /sys/class/net/$iface/mtu 2>/dev/null || echo "0")
          MAC=$(cat /sys/class/net/$iface/address 2>/dev/null || echo "")
          RX=$(cat /sys/class/net/$iface/statistics/rx_bytes 2>/dev/null || echo "0")
          TX=$(cat /sys/class/net/$iface/statistics/tx_bytes 2>/dev/null || echo "0")
          RX_ERR=$(cat /sys/class/net/$iface/statistics/rx_errors 2>/dev/null || echo "0")
          TX_ERR=$(cat /sys/class/net/$iface/statistics/tx_errors 2>/dev/null || echo "0")
          RX_DROP=$(cat /sys/class/net/$iface/statistics/rx_dropped 2>/dev/null || echo "0")
          TX_DROP=$(cat /sys/class/net/$iface/statistics/tx_dropped 2>/dev/null || echo "0")
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"name\":\"${iface}\",\"state\":\"${STATE}\",\"carrier\":${CARRIER},\"speed\":${SPEED},\"mtu\":${MTU},\"mac\":\"${MAC}\",\"rx_bytes\":${RX},\"tx_bytes\":${TX},\"rx_errors\":${RX_ERR},\"tx_errors\":${TX_ERR},\"rx_dropped\":${RX_DROP},\"tx_dropped\":${TX_DROP}}"
          FIRST=0
        done
        RESULT="${RESULT}]"
        json_ok "{\"interfaces\":${RESULT},\"timestamp\":$(date +%s 2>/dev/null || echo 0)}"
        ;;
      mon.traffic)
        RESULT="["
        FIRST=1
        while IFS=: read -r iface stats; do
          iface=$(echo "$iface" | xargs)
          [ "$iface" = "lo" ] && continue
          [ -z "$iface" ] && continue
          RX_BYTES=$(echo "$stats" | awk '{print $1}')
          RX_PKTS=$(echo "$stats" | awk '{print $2}')
          RX_ERRS=$(echo "$stats" | awk '{print $3}')
          RX_DROP=$(echo "$stats" | awk '{print $4}')
          TX_BYTES=$(echo "$stats" | awk '{print $9}')
          TX_PKTS=$(echo "$stats" | awk '{print $10}')
          TX_ERRS=$(echo "$stats" | awk '{print $11}')
          TX_DROP=$(echo "$stats" | awk '{print $12}')
          [ $FIRST -eq 0 ] && RESULT="${RESULT},"
          RESULT="${RESULT}{\"interface\":\"${iface}\",\"rx_bytes\":${RX_BYTES:-0},\"rx_packets\":${RX_PKTS:-0},\"rx_errors\":${RX_ERRS:-0},\"rx_dropped\":${RX_DROP:-0},\"tx_bytes\":${TX_BYTES:-0},\"tx_packets\":${TX_PKTS:-0},\"tx_errors\":${TX_ERRS:-0},\"tx_dropped\":${TX_DROP:-0}}"
          FIRST=0
        done < /proc/net/dev 2>/dev/null
        RESULT="${RESULT}]"
        json_ok "{\"counters\":${RESULT},\"timestamp\":$(date +%s 2>/dev/null || echo 0)}"
        ;;
      mon.connections)
        COUNT=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
        MAX=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo "0")
        json_ok "{\"count\":${COUNT},\"max\":${MAX}}"
        ;;
      mon.uptime)
        UPTIME=$(cat /proc/uptime 2>/dev/null | awk '{print int($1)}')
        IDLE=$(cat /proc/uptime 2>/dev/null | awk '{print int($2)}')
        json_ok "{\"uptime_seconds\":${UPTIME:-0},\"idle_seconds\":${IDLE:-0}}"
        ;;
      *)
        printf '{"success":false,"implemented":false,"source":"unavailable","data":null,"message":"该功能尚未接入真实系统"}\n'
        ;;
    esac
  ;;
esac
