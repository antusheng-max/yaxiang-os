#!/bin/sh /etc/rc.common
# Yaxiang OS Core Service - procd managed
# Provides: start, stop, restart, reload, enabled status

START=98
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/yaxiang-collect
  procd_set_param respawn 3600 5 10
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param limits core="unlimited"
  procd_close_instance
}

stop_service() {
  true
}

reload_service() {
  procd_send_signal yaxiang-collect HUP
}
