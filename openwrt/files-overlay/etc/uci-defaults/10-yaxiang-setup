#!/bin/sh
# Yaxiang OS First Boot Configuration
# Idempotent - safe to run multiple times
# Exits on error

set -e

# Skip if already applied
[ -f /etc/yaxiang-firstboot-applied ] && exit 0

echo "[yaxiang-defaults] Applying first-boot configuration..."

# ===== Hostname =====
uci set system.@system[0].hostname='Yaxiang-Gateway'

# ===== LAN Configuration =====
# Set LAN IPv4 to 192.168.1.1/24
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci delete network.lan.ip6assign 2>/dev/null || true

# ===== DHCP =====
uci set dhcp.lan.ignore='0'
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'

# ===== uHTTPd =====
uci set uhttpd.main.listen_http='0.0.0.0:80' '[::]:80'
uci set uhttpd.main.home='/www'
uci set uhttpd.main.index_page='index.html'

# ===== Security: Disable WAN-side Web and SSH =====
# uHTTPd RFC1918 filter (already enabled by default)
uci set uhttpd.main.rfc1918_filter='1'

# Dropbear (SSH) - configure to listen on LAN only
uci set dropbear.@dropbear[0].Interface='lan' 2>/dev/null || true

# ===== Firewall: Block WAN access to management =====
# Add firewall rule to reject WAN -> device management ports
uci add firewall rule
uci set firewall.@rule[-1].name='Reject-WAN-Management'
uci set firewall.@rule[-1].src='wan'
uci set firewall.@rule[-1].dest_port='22 80 443'
uci set firewall.@rule[-1].proto='tcp'
uci set firewall.@rule[-1].target='REJECT'

# ===== Timezone =====
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'

# ===== Create Yaxiang directories =====
mkdir -p /etc/yaxiang
mkdir -p /var/run/yaxiang
mkdir -p /var/log/yaxiang

# ===== Commit all changes =====
uci commit

# ===== Mark as applied =====
touch /etc/yaxiang-firstboot-applied

echo "[yaxiang-defaults] First-boot configuration applied successfully."
exit 0
