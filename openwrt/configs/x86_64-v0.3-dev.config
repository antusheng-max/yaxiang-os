# Yaxiang OS V0.3-dev - x86_64 Build Configuration
# For OpenWrt Image Builder 25.12.5

# Target configuration
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# Profile
PROFILE=generic

# Image Builder path
IMAGE_BUILDER=/root/openwrt-imagebuilder-25.12.5-x86-64.Linux-x86_64

# Output directory
OUTPUT_DIR=/root/project/openwrt/output/v0.3-dev

# Web dist path
WEB_DIST=/root/project/web/dist

# Package directory (custom packages)
PACKAGE_DIR=/root/project/openwrt/packages/yaxiang

# Files overlay directory
FILES_DIR=/root/project/openwrt/files-overlay

# Product info
PRODUCT_NAME="Yaxiang-OS"
PRODUCT_VERSION="V0.3-dev"
ARCH="x86_64"
